# ШАБЛОН прод-переменных. На сервере: cp .env.production.example .env  и заполни значения.
# Файл .env в .gitignore — реальные секреты в репозиторий не коммитятся.

# --- Postgres (контейнер db в docker-compose.prod.yml) ---
# Придумай НЕ дефолтный пароль. Из этих трёх переменных compose собирает DATABASE_URL.
POSTGRES_USER=aqua
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=aqua

# DATABASE_URL здесь НЕ задаём — его строит docker-compose.prod.yml (host = db).

# --- Telegram-боты (ОТДЕЛЬНЫЕ прод-токены от @BotFather) ---
# ВАЖНО: один токен = один polling-инстанс. Не используй эти токены больше нигде,
# иначе второй процесс словит 409 Conflict.
CLIENT_BOT_TOKEN=
DISPATCHER_BOT_TOKEN=

# Chat id супер-админа диспетчера (всегда получает заказы, правит список диспетчеров).
DISPATCHER_CHAT_ID=

# Резервный телефон поддержки. БЕЗ него приложение не стартует (fatal-проверка в main.ts).
# Заменить заглушку на реальный номер.
SUPPORT_PHONE=+380XXXXXXXXX
