// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Модель данных и расчёт цены — PRODUCT.md (расчёт суммы — только в pricing.service).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // Проект компилируется в CommonJS (tsconfig module=nodenext, без "type":"module").
  // Без этого новый генератор Prisma 7 выдаёт ESM-исходники с import.meta.url,
  // которые ломаются в рантайме под Node ("exports is not defined in ES module scope").
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Статусы заказа (SPEC §4 / §7).
enum OrderStatus {
  CREATED
  ACCEPTED
  DELIVERED
  CANCELLED
}

/// Клиент бота. Идентифицируется по Telegram-аккаунту и телефону.
model Client {
  id         String   @id @default(uuid())
  /// Telegram user id — bigint, не int32 (легко переваливает за 2^31).
  telegramId BigInt   @unique
  phone      String   @unique
  name       String?
  createdAt  DateTime @default(now())

  addresses Address[]
  orders    Order[]
}

/// Адрес доставки. На старте обычно один (isDefault), модель допускает несколько.
model Address {
  id        String   @id @default(uuid())
  clientId  String
  raw       String
  comment   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([clientId])
}

/// Заказ. totalPrice фиксируется на момент оформления и не пересчитывается (SPEC §4).
model Order {
  id           String      @id @default(uuid())
  clientId     String
  addressId    String
  bottles      Int
  /// true → сумма по стартовому комплекту (залог + помпа + старт-вода), PRODUCT.md.
  isFirstOrder Boolean
  /// Зафиксированная сумма заказа в гривнах (целое, без копеек).
  totalPrice   Int
  status       OrderStatus @default(CREATED)
  createdAt    DateTime    @default(now())
  acceptedAt   DateTime?
  deliveredAt  DateTime?

  client  Client  @relation(fields: [clientId], references: [id])
  address Address @relation(fields: [addressId], references: [id])

  @@index([clientId])
  @@index([status])
}

/// Настройки цен — синглтон (одна строка на всю систему).
/// id всегда = 1; сид создаёт строку с дефолтами (PRODUCT.md «Ценообразование»).
model PriceSettings {
  id               Int      @id @default(1)
  /// Сетка воды (город) по количеству: 1 / от 2 / от 6.
  price1           Int      @default(80)
  priceFrom2       Int      @default(70)
  priceFrom6       Int      @default(65)
  /// Компоненты стартового комплекта и докупки: залог, помпа, электро-помпа, старт-вода.
  depositPerBottle Int      @default(450)
  pumpPrice        Int      @default(250)
  electroPumpPrice Int      @default(270)
  waterStartPrice  Int      @default(50)
  updatedAt        DateTime @updatedAt
}
