// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Data model and price calculation — PRODUCT.md (total calculation — only in pricing.service).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // The project compiles to CommonJS (tsconfig module=nodenext, no "type":"module").
  // Without this the new Prisma 7 generator emits ESM sources with import.meta.url,
  // which break at runtime under Node ("exports is not defined in ES module scope").
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Order statuses (PRODUCT.md "End-to-end order path").
enum OrderStatus {
  CREATED
  ACCEPTED
  DELIVERED
  CANCELLED
}

/// Order kind — determines the total calculation (PRODUCT.md "Pricing").
/// STARTER_KIT — starter kit; OWN_TARA — own bottles (water, deposit 0);
/// REPEAT — repeat (grid + tara top-up above the remainder).
enum OrderKind {
  STARTER_KIT
  OWN_TARA
  REPEAT
}

/// Bot client. Identified by Telegram account and phone.
model Client {
  id         String   @id @default(uuid())
  /// Telegram user id — bigint, not int32 (easily exceeds 2^31).
  telegramId BigInt   @unique
  phone      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  /// Client tara/pump state (PRODUCT.md): for tara top-up and skipping onboarding.
  bottlesOnHand Int     @default(0)
  hasPump       Boolean @default(false)
  /// The client claimed to be already existing ("I am already your client"), but the
  /// dispatcher has not verified yet. Cleared when their order is accepted (PRODUCT.md, STEP3 T4).
  pendingReview Boolean @default(false)

  addresses Address[]
  orders    Order[]
}

/// Delivery address. Usually one at the start (isDefault), the model allows several.
model Address {
  id        String   @id @default(uuid())
  clientId  String
  raw       String
  comment   String?
  isDefault Boolean  @default(false)
  /// Delivery coordinates for future route optimization. The client enters the
  /// address as free text; the dispatcher attaches the point on demand (Telegram
  /// location pin on mobile, or a pasted coords / maps link). Null until tagged.
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([clientId])
}

/// Order. totalPrice is frozen at ordering time and not recomputed (SPEC §4).
model Order {
  id           String      @id @default(uuid())
  clientId     String
  addressId    String
  bottles      Int
  /// Order kind (PRODUCT.md): determines the total calculation in pricing.service.
  kind         OrderKind
  /// Bottles of this order that are new tara under deposit — snapshot at creation
  /// (like totalPrice). Drives the dispatcher breakdown and the tara credit on delivery.
  newTara      Int         @default(0)
  /// Starter kit with an electric pump (270 instead of 250). STEP3 T5.
  electro      Boolean     @default(false)
  /// OWN_TARA with a pump add-on (+250) if the client has none. STEP3 T5.
  pumpAddon    Boolean     @default(false)
  /// Bottles the client SELF-DECLARED having on hand at onboarding ("I already have
  /// bottles"). Set only on a first OWN_TARA order; null otherwise. The claim is NOT
  /// committed to Client.bottlesOnHand until the dispatcher accepts the order
  /// (deferred commit / verification — PRODUCT.md). Also drives the dispatcher "verify
  /// N bottles" mark.
  claimedOnHand Int?
  /// Client note about THIS order (entered at ordering, optional): one-off info for
  /// the dispatcher/driver, e.g. "мене не буде з 14 до 16". Distinct from
  /// Address.comment (a permanent hint about the delivery point, reused across orders).
  note         String?
  /// Last delivery-timing message the dispatcher sent the client about this order
  /// (e.g. "сьогодні", "перенесено на завтра"). Updatable; each change pushes the
  /// client and is echoed on the dispatcher card. Null until the dispatcher sets one.
  deliveryNote String?
  /// Frozen order total in UAH (integer, no kopecks).
  totalPrice   Int
  status       OrderStatus @default(CREATED)
  createdAt    DateTime    @default(now())
  acceptedAt   DateTime?
  deliveredAt  DateTime?

  // onDelete: Cascade — convenience for dev/tests: deleting a Client (or its
  // Address) wipes the related orders. NOTE: this loses order history and affects
  // /stats — reconsider before production (e.g. soft-delete or onDelete: Restrict).
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

/// Price settings — a singleton (one row for the whole system).
/// id is always = 1; the seed creates the row with defaults (PRODUCT.md "Pricing").
model PriceSettings {
  id               Int      @id @default(1)
  /// Water grid (city) by quantity: 1 / from 2 / from 6.
  price1           Int      @default(80)
  priceFrom2       Int      @default(70)
  priceFrom6       Int      @default(65)
  /// Starter-kit and add-on components: deposit, pump, electric pump, starter water.
  depositPerBottle Int      @default(450)
  pumpPrice        Int      @default(250)
  electroPumpPrice Int      @default(270)
  waterStartPrice  Int      @default(50)
  updatedAt        DateTime @updatedAt
}
