# Production image — multi-stage.
# Stage 1 (builder): ставит ВСЕ зависимости, генерит Prisma-клиент, собирает dist.
# Stage 2 (runner): только прод-зависимости + готовый dist. Лёгкий образ без тулчейна.
#
# Почему multi-stage: в финальный образ не тащим nest-cli, typescript, eslint и т.п.
# (девтулзы нужны только на этапе сборки). Меньше образ — меньше поверхность атаки.

# ---------- builder ----------
FROM node:22-alpine AS builder
WORKDIR /app

# Зависимости — отдельным слоем: пересобирается только при изменении lock-файла.
COPY package.json package-lock.json ./
RUN npm ci

# tsconfig копируем ДО генерации: генератор Prisma 7 читает его, чтобы выбрать формат
# импортов (.js для CJS). Схема также фиксирует importFileExtension="js" — двойная страховка.
COPY tsconfig.json tsconfig.build.json nest-cli.json ./

# Prisma-клиент генерится в generated/prisma (см. schema output). Нужен ДО сборки:
# без него не пройдут ни типы, ни nest build. Отдельный слой — кешируется, пока не
# менялись prisma/ или tsconfig (не пересобирается при правке src).
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

# Исходники → компиляция в dist/.
# nest build компилит и src/, и generated/ → dist/src, dist/generated (импорты сходятся).
COPY src ./src
RUN npm run build

# ---------- runner ----------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Только прод-зависимости (prisma CLI и adapter-pg — прод, поэтому migrate deploy
# и рантайм работают без девтулзов).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Готовый билд: dist/src (приложение) + dist/generated/prisma (клиент).
COPY --from=builder /app/dist ./dist

# Схема + миграции + конфиг — нужны для `prisma migrate deploy` на старте контейнера.
COPY --from=builder /app/prisma ./prisma
COPY prisma.config.ts ./

# Entrypoint: сначала накатывает миграции, потом стартует бота.
COPY docker/entrypoint.sh ./docker/entrypoint.sh
RUN chmod +x ./docker/entrypoint.sh

# Служебный порт NestJS (боты работают через long polling, входящий трафик не нужен).
EXPOSE 3000

CMD ["./docker/entrypoint.sh"]
