# ШАБЛОН переменных ДЕМО-СТЕНДА. Локально: cp .env.demo.example .env.demo и заполни.
# .env.demo в .gitignore — реальные токены в репозиторий не попадают.
#
# Демо-стенд — отдельный процесс, отдельная БД и ОТДЕЛЬНЫЕ боты. Он не имеет ничего
# общего с продом: у прода свой .env, свой compose-проект и свой volume.
# Что меняет DEMO_MODE — см. DEMO.md.

# --- Демо-режим ---
DEMO_MODE=true

# Через сколько секунд «диспетчер» сам примет и доставит заказ.
# Дефолты (25/45) подобраны под живой показ: успеваешь открыть диспетчерский бот и
# увидеть карточку до того, как она обработается.
DEMO_ACCEPT_DELAY_SEC=25
DEMO_DELIVER_DELAY_SEC=45

# Сколько часов живут данные посетителя до автоудаления (0 = чистить на каждом проходе).
DEMO_TTL_HOURS=24
# Как часто крутится чистка, минут (для проверки можно поставить 1).
DEMO_CLEANUP_INTERVAL_MIN=60

# --- Postgres (контейнер db в docker-compose.demo.yml) ---
POSTGRES_USER=aqua_demo
POSTGRES_PASSWORD=CHANGE_ME_demo_password
POSTGRES_DB=aqua_demo

# --- Подключение к БД (две переменные — это не дублирование) ---
# DATABASE_URL — для процесса НА ХОСТЕ (npm run start:demo, npm run demo:migrate):
#   демо-БД слушает 5433, чтобы не конфликтовать с локальной базой на 5432.
# DOCKER_DATABASE_URL — для процесса В КОНТЕЙНЕРЕ: там хост БД — имя сервиса `db`.
#   Его подставляет docker/entrypoint.sh. Пароль в обеих строках должен совпадать с
#   POSTGRES_PASSWORD выше (спецсимволы в пароле — percent-encode, напр. @ → %40).
DATABASE_URL="postgresql://aqua_demo:CHANGE_ME_demo_password@localhost:5433/aqua_demo?schema=public"
DOCKER_DATABASE_URL="postgresql://aqua_demo:CHANGE_ME_demo_password@db:5432/aqua_demo?schema=public"

# --- Telegram-боты (ОТДЕЛЬНЫЕ ДЕМО-токены от @BotFather) ---
# ⚠️ Никогда не прод-токены: один токен = один polling-инстанс, иначе 409 Conflict
# и живой прод перестанет получать апдейты.
CLIENT_BOT_TOKEN=
DISPATCHER_BOT_TOKEN=

# Твой chat id — супер-админ демо-стенда. Chat-guard в демо выключен (заходит любой),
# но список диспетчеров (/dispatchers) правит только этот chat id.
DISPATCHER_CHAT_ID=

# Резервный телефон поддержки. БЕЗ него приложение не стартует (fatal-проверка в main.ts).
# На демо это тоже витрина — поставь номер, который не жалко показать.
SUPPORT_PHONE=+380000000000
