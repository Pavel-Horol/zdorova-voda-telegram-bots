# Подключение к БД (Prisma 7 через @prisma/adapter-pg).
# Локально: подними БД из docker-compose (`docker compose up -d db`) и используй localhost.
# Внутри docker-сети хост БД — `db` (значение задаётся в docker-compose.yml).
DATABASE_URL="postgresql://aqua:aqua@localhost:5432/aqua?schema=public"

# Telegram-боты (два токена, один процесс) — SPEC §2.
CLIENT_BOT_TOKEN=
DISPATCHER_BOT_TOKEN=

# Chat id диспетчера — куда слать уведомления о заказах (SPEC §7, §11).
DISPATCHER_CHAT_ID=

# Второй диспетчерский чат (опционально): заказы уходят в оба, оба проходят chat-guard.
DISPATCHER2_CHAT_ID=

# Телефон поддержки (заглушка, заменить перед запуском) — SPEC §11.
SUPPORT_PHONE=+380XXXXXXXXX
