# Подключение к БД (Prisma 7 через @prisma/adapter-pg).
# Локально: подними БД из docker-compose (`docker compose up -d db`) и используй localhost.
# Внутри docker-сети хост БД — `db` (значение задаётся в docker-compose.yml).
DATABASE_URL="postgresql://aqua:aqua@localhost:5432/aqua?schema=public"

# Telegram-боты (два токена, один процесс) — SPEC §2.
CLIENT_BOT_TOKEN=
DISPATCHER_BOT_TOKEN=

# Chat id супер-админа диспетчера — всегда получает заказы, проходит chat-guard и
# единственный управляет списком диспетчеров в боте (/dispatchers). Остальные
# диспетчеры добавляются через бота и хранятся в БД (модель Dispatcher).
DISPATCHER_CHAT_ID=

# Телефон поддержки (заглушка, заменить перед запуском) — SPEC §11.
SUPPORT_PHONE=+380XXXXXXXXX

# Демо-стенд (показ продукта покупателям) сюда НЕ настраивается: у него свой файл
# .env.demo — шаблон в .env.demo.example, описание режима в DEMO.md.
# Какой файл читается, решает ENV_FILE (по умолчанию .env).
